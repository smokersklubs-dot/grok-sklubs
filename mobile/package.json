{
  "name": "sklubot-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@react-navigation/bottom-tabs": "^7.22.0",
    "@react-navigation/native": "^7.5.2",
    "@react-navigation/native-stack": "^7.21.1",
    "expo": "~58.0.25",
    "expo-application": "~58.1.2",
    "expo-background-task": "~58.0.13",
    "expo-build-properties": "~58.0.12",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.16",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-haptics": "~58.0.8",
    "expo-image": "~58.0.18",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.17",
    "expo-localization": "~58.0.5",
    "expo-notifications": "~58.1.9",
    "expo-secure-store": "~58.0.3",
    "expo-sharing": "~58.0.23",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-task-manager": "~58.0.14",
    "expo-web-browser": "~58.0.8",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "@types/jest": "30.0.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "qa": "tsc --noEmit && jest && node --test scripts/store-check.test.mjs",
    "store:check": "node scripts/store-check.mjs",
    "test:store": "node --test scripts/store-check.test.mjs"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/android",
      "<rootDir>/modules"
    ]
  }
}
