<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="relay_brand">#E0502F</color>
    <color name="relay_surface">#F3F2EE</color>
    <style name="RelayTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorAccent">@color/relay_brand</item>
        <item name="android:windowBackground">@color/relay_surface</item>
        <item name="android:statusBarColor">@color/relay_surface</item>
        <item name="android:navigationBarColor">@color/relay_surface</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="ConsentTheme" parent="android:Theme.Material.Light.Dialog">
        <item name="android:windowNoTitle">true</item>
        <item name="android:colorAccent">@color/relay_brand</item>
        <item name="android:windowCloseOnTouchOutside">false</item>
    </style>
</resources>
