    "jose": "6.2.17",
    "mailauth": "^8.0.6",
    "mailparser": "^3.14.3",
    "nodemailer": "^10.5.0",
    "sharp": "0.35.5",
    "smtp-server": "^3.21.4",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
