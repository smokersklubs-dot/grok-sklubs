# ── Obligatoire ──────────────────────────────────────────────────────────────
# Secret pour les sessions et le chiffrement des jetons de connecteurs.
# Génère-le avec :  openssl rand -hex 32
SESSION_SECRET=

# Au moins un fournisseur de modèle. Claude est recommandé (défaut : claude-fable-5-2).
ANTHROPIC_API_KEY=
# XAI_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1     # tout service compatible (serveur local, etc.)
# OPENAI_MODELS=gpt-5                           # liste séparée par des virgules

# ── Optionnel ────────────────────────────────────────────────────────────────
# DEFAULT_MODEL=anthropic:claude-fable-5-2      # modèle par défaut des bots (fournisseur:modèle)
# AUX_MODEL=anthropic:claude-haiku-5-5          # modèle économique pour résumés et mémoire
# PORT=8787
# PUBLIC_URL=http://localhost:8787              # adresse publique (liens de webhooks, cookies sécurisés en https)
# DATA_DIR=./data                               # base de données, dossiers et profils navigateur des bots
# OPEN_SIGNUP=0                                 # 1 = autoriser d'autres comptes après le premier
# SHELL_ENABLED=                                # 0 = retirer la ligne de commande aux bots ; sans Docker, 1 = l'autoriser
#                                               #   sur ce serveur (chaque commande demande alors ton accord)
# SETUP_CODE=                                   # code demandé pour créer le premier compte (serveur public)
# TRUST_PROXY=0                                 # 1 = derrière ton propre proxy (Caddy, Traefik) : adresse client = dernière de X-Forwarded-For
# ALLOW_PRIVATE_FETCH=0                         # 1 = laisser les bots joindre des adresses locales/privées (tests seulement)
# COMPUTER=auto                                 # auto = Linux si Docker + image, sinon navigateur ; linux ; browser
# MAX_DESKTOPS=4                                # ordinateurs de bots éveillés en même temps
# DESKTOP_IDLE_MIN=20                           # mise en veille d'un ordinateur inactif
# COMPUTER_WAIT_SEC=90                          # tous les ordinateurs occupés : attente max avant d'en réveiller un autre
#                                               #   (un ordinateur occupé n'est jamais mis en veille)
# ENGINE_TURN_TIMEOUT_MINUTES=60                # durée max d'un tour Claude Code / Codex (0 = sans limite)
# BOT_WAIT_DEFAULT_SECONDS=180                  # bot_message avec attente : attente par défaut de la réponse d'un autre bot
# BOT_WAIT_MAX_SECONDS=600                      #   et attente maximale (au-delà, la réponse arrive plus tard en message)
# DISK_ALERT_PERCENT=90                         # disque d'un ordinateur de bot rempli à ce point : carte « disque plein »
# CODEX_MODELS=default                          # modèles Codex proposés si la liste réelle (codex debug models) échoue
# CLAUDE_CODE_MODELS=sonnet,opus,fable,haiku    # modèles Claude Code proposés
# DESKTOP_MEMORY=2g                             # mémoire par ordinateur
# DESKTOP_CPUS=2                                # processeurs par ordinateur
# DESKTOP_RESOLUTION=1280x800x24
# MAX_STEPS=60                                  # étapes maximum par tour
# COMPACT_CHARS=300000                          # taille de conversation qui déclenche le résumé
# NO_SCHEDULER=0                                # 1 = pas de routines ni de points réguliers

# DEMO_MODE=1                                   # essayer sans clé ni coût : un faux modèle qui suit des mots-clés

# ── Génération d'images (facultatif) ─────────────────────────────────────────
# Active avec OPENAI_API_KEY ou XAI_API_KEY, ou un service compatible :
# IMAGE_API_KEY=
# IMAGE_BASE_URL=https://api.openai.com/v1
# IMAGE_MODEL=gpt-image-1

# ── Génération de vidéos (facultatif) ────────────────────────────────────────
# Le plus simple : connecter Higgsfield dans Réglages → Apps (ton abonnement Higgsfield, chaque vidéo
# utilise tes crédits). Sinon une API vidéo, payée à la vidéo ; sans rien de tout ça, l'outil n'est pas proposé.
# VIDEO_PROVIDER=                               # xai | gemini | off (vide = celui qui a une clé, xAI d'abord)
# VIDEO_XAI_API_KEY=                            # sinon XAI_API_KEY ci-dessus est utilisée
# XAI_VIDEO_MODEL=grok-imagine-video-1.5
# GEMINI_API_KEY=
# GEMINI_VIDEO_MODEL=gemini-omni-1.2-flash

# ── Fiabilité et recherche (facultatif) ──────────────────────────────────────
# FALLBACK_MODEL=anthropic:claude-opus-5-5      # modèle de secours si celui du bot ne répond pas
# BRAVE_API_KEY=                                # recherche web pour les modèles autres que Claude
# SEARXNG_URL=https://searx.exemple.fr          # ou ta propre instance SearXNG

# ── Comptes (facultatif) ─────────────────────────────────────────────────────
# ALLOWED_EMAILS=toi@exemple.fr,associe@exemple.fr   # seules ces adresses peuvent créer un compte
# Attention : ALLOWED_EMAILS n'est PAS une authentification. Sklubot ne vérifie pas que la personne qui s'inscrit
# reçoit bien les e-mails de cette adresse : quelqu'un qui devine une adresse de la liste peut créer le compte à sa place.
# Pour une installation ouverte sur Internet, garde OPEN_SIGNUP=0 et invite les gens (lien d'invitation à usage unique).
# Note: ALLOWED_EMAILS is not authentication — the address is not verified; anyone who knows a listed address can sign up with it.
