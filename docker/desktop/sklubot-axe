#!/usr/bin/env node
// L115 — axe accessibility check of one page with the computer's own Chromium (no chromedriver, no second browser):
//   sklubot-axe <url> [--json <file>] [--width <px>] [--height <px>]
// Prints the violations in short lines (rule, impact, how many elements, the first one) and, with --json, saves axe's
// full results there. Exit code: 0 no violation, 1 violations found, 2 the page could not be checked.
// APIs used: axe-core 4.14 (MPL-2.0, https://github.com/dequelabs/axe-core/blob/develop/doc/API.md — axe.source,
// axe.run(context, options) with runOnly tags) injected with Puppeteer 25 (Apache-2.0, https://pptr.dev/api —
// puppeteer.launch, Page.setViewport, Page.goto, Page.evaluate). The browser is the computer's Chromium through
// /opt/sklubot/headless-chromium (PUPPETEER_EXECUTABLE_PATH). axe-core itself is unmodified.
"use strict";
const { createRequire } = require("node:module");
const fs = require("node:fs");
const lib = createRequire(process.env.SKLUBOT_WEB_TOOLS || "/opt/sklubot/web-tools/package.json");
const axeSource = lib("axe-core").source;
const puppeteer = lib("puppeteer-core");

const args = process.argv.slice(2);
const opt = (name, dflt) => { const i = args.indexOf(name); if (i < 0) return dflt; const v = args[i + 1]; args.splice(i, 2); return v; };
const jsonOut = opt("--json", "");
const width = Number(opt("--width", "390")) || 390;
const height = Number(opt("--height", "844")) || 844;
const url = args[0];
if (!url || !/^(https?|file):/i.test(url)) { console.error("usage: sklubot-axe <http(s) url> [--json <file>] [--width <px>] [--height <px>]"); process.exit(2); }

(async () => {
  const browser = await puppeteer.launch({ executablePath: process.env.PUPPETEER_EXECUTABLE_PATH || "/opt/sklubot/headless-chromium", headless: true, args: ["--no-first-run", "--no-default-browser-check"] });
  try {
    const page = await browser.newPage();
    await page.setBypassCSP(true); // the page's own Content-Security-Policy must not block the checker
    await page.setViewport({ width, height });
    await page.goto(url, { waitUntil: "load", timeout: 45_000 });
    await page.evaluate(axeSource);
    const results = await page.evaluate(() => globalThis.axe.run(document, { runOnly: { type: "tag", values: ["wcag2a", "wcag2aa", "wcag21a", "wcag21aa", "wcag22aa", "best-practice"] }, resultTypes: ["violations"] }));
    if (jsonOut) fs.writeFileSync(jsonOut, JSON.stringify(results, null, 1));
    const v = results.violations || [];
    console.log(`axe-core ${results.testEngine && results.testEngine.version}: ${v.length} rule${v.length === 1 ? "" : "s"} failed on ${url} at ${width}x${height}`);
    for (const r of v) {
      const first = r.nodes[0] ? String(r.nodes[0].target.join(" ")).slice(0, 120) : "";
      console.log(`- ${r.id} (${r.impact || "?"}, ${r.nodes.length} element${r.nodes.length === 1 ? "" : "s"}): ${r.help}${first ? ` — e.g. ${first}` : ""}`);
    }
    process.exitCode = v.length ? 1 : 0;
  } finally { await browser.close(); }
})().catch((err) => { console.error(`sklubot-axe: ${String(err && err.message || err).slice(0, 300)}`); process.exit(2); });
