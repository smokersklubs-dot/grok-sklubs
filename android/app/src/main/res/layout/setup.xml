<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_horizontal" android:orientation="vertical" android:padding="28dp">

        <ImageView
            android:layout_width="72dp" android:layout_height="72dp" android:layout_marginTop="48dp"
            android:contentDescription="@string/app_name" android:src="@mipmap/ic_launcher" />

        <TextView
            android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:text="@string/setup_title" android:textColor="@color/ink"
            android:textSize="22sp" android:textStyle="bold" />

        <TextView
            android:id="@+id/message" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:gravity="center" android:lineSpacingMultiplier="1.15"
            android:text="@string/setup_text" android:textColor="#55575E" android:textSize="15sp" />

        <EditText
            android:id="@+id/address" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:hint="@string/setup_hint" android:imeOptions="actionGo"
            android:importantForAutofill="no" android:inputType="textUri" android:minHeight="48dp" android:singleLine="true" />

        <TextView
            android:id="@+id/error" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:textColor="#B3261E" android:textSize="14sp" android:visibility="gone" />

        <Button
            android:id="@+id/connect" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:minHeight="52dp" android:text="@string/setup_button" />
    </LinearLayout>
</ScrollView>
