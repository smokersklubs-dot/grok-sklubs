# Caddy pour Sklubot (docker-compose.vps.yml). SITE_ADDRESS : le nom de domaine (HTTPS automatique) ou « :80 ».
{$SITE_ADDRESS::80} {
	# Le point d'accès des outils (/mcp/…) ne sert qu'aux ordinateurs des bots, qui joignent Sklubot
	# directement sur le réseau interne (http://sklubot:3000). Depuis Internet, il n'existe pas.
	# Pareil pour le relais d'identifiants (/egress/…, vague 7) : seuls les programmes des ordinateurs des bots s'en servent.
	@mcp path /mcp /mcp/* /egress /egress/*
	respond @mcp 404

	# Les fichiers de 1 Go arrivent par blocs de 8 Mo. Le plafond de 97 Mo permet aussi
	# les anciens envois directs de 96 Mo et leur enveloppe multipart.
	# Directive « request_body » : https://caddyserver.com/docs/caddyfile/directives/request_body
	request_body {
		max_size 97MB
	}

	# Caddy remplace X-Forwarded-For par l'adresse réelle du visiteur (il ne fait confiance à aucun en-tête reçu).
	reverse_proxy sklubot:3000
}
