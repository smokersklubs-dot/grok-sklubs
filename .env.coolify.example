# Adresse publique (le domaine que Coolify sert en HTTPS)
SKLUBOT_PUBLIC_URL=https://bots.exemple.fr

# Secret : 64 caractères hexadécimaux (openssl rand -hex 32). Ne le commit jamais.
SKLUBOT_SESSION_SECRET=CHANGE_ME_64_HEX

# Code demandé pour créer le premier compte (mets une valeur au hasard : openssl rand -hex 6)
SKLUBOT_SETUP_CODE=

# Au moins une clé de modèle (ou SKLUBOT_DEMO_MODE=1 pour essayer sans clé)
ANTHROPIC_API_KEY=
XAI_API_KEY=
OPENAI_API_KEY=
SKLUBOT_DEMO_MODE=0

# Optionnel
SKLUBOT_DEFAULT_MODEL=
SKLUBOT_OPEN_SIGNUP=0
SKLUBOT_MAX_DESKTOPS=4
# SKLUBOT_ENGINE_TURN_TIMEOUT_MINUTES=60
SKLUBOT_DESKTOP_MEMORY=2g
# Processeurs par ordinateur de bot (2 par défaut ; 4 rend l'écran plus fluide pendant une connexion)
SKLUBOT_DESKTOP_CPUS=2
# Clavier des ordinateurs des bots : us (par défaut), fr pour AZERTY, de…
SKLUBOT_DESKTOP_KEYBOARD=us
# Ordinateurs partagés entre les bots d'un même compte : au plus ce nombre par compte (Réglages → Ordinateur).
# SKLUBOT_MAX_SHARED_COMPUTERS=3
# Facultatif : disque propre maximal de chaque ordinateur (ex. 20G ; seulement overlay2 sur xfs+pquota, btrfs, zfs).
# SKLUBOT_DESKTOP_DISK_QUOTA=
# Sous cet espace libre (Mo), l'ordinateur inactif qui a le plus écrit est mis en veille (0 = jamais).
# SKLUBOT_DISK_FREE_MIN_MB=2048
# Facultatif : runtime des ordinateurs (runsc = gVisor, à installer sur l'hôte).
# SKLUBOT_DESKTOP_RUNTIME=
# Secours seulement : l'ancienne façon de joindre Sklubot (réseau partagé). Avec elle, mets aussi
# SKLUBOT_PROXY_NETWORKS=sklubot_bots,sklubot_net
# SKLUBOT_BOT_LINK=socket
# ALLOWED_EMAILS n'est pas une authentification : l'adresse n'est pas vérifiée. Garde OPEN_SIGNUP=0 et invite les gens.
# SKLUBOT_ALLOWED_EMAILS=
