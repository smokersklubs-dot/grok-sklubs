# Sklubot server + web app in one image. The bots' Linux computers are separate containers that this
# server starts through the host's Docker engine (see docker-compose.coolify.yml).
ARG NODE_IMAGE=node:22-bookworm-slim
ARG DOCKER_CLI_IMAGE=docker:28-cli
FROM ${DOCKER_CLI_IMAGE} AS dockercli
FROM ${NODE_IMAGE} AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY server/package.json server/
COPY web/package.json web/
RUN npm ci
COPY tsconfig.base.json ./
COPY server server
COPY web web
RUN npm run build && npm prune --omit=dev

FROM ${NODE_IMAGE}
# The Docker command-line client only: the engine is the host's, reached through its socket.
COPY --from=dockercli /usr/local/bin/docker /usr/local/bin/docker
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
ENV NODE_ENV=production DATA_DIR=/data PORT=3000
COPY --from=build /app/node_modules node_modules
COPY --from=build /app/package.json ./
COPY --from=build /app/server/package.json server/
COPY --from=build /app/server/dist server/dist
# The built-in team templates (server/src/teamfile.ts) are read from server/templates, next to dist.
COPY --from=build /app/server/templates server/templates
COPY docker/desktop/install-craft.sh docker/desktop/install-craft.sh
# The bundled skills library (server/src/skillslibrary.ts), with each skill's LICENSE.txt and NOTICE.
COPY --from=build /app/server/skills-library server/skills-library
COPY --from=build /app/web/dist web/dist
EXPOSE 3000
CMD ["node", "server/dist/index.js"]
