{
  "name": "sklubot-relais",
  "productName": "Sklubot Relais",
  "version": "0.1.0",
  "description": "Sklubot Relais : laisse tes bots Sklubot voir et piloter ton ordinateur, avec ton accord.",
  "license": "MIT",
  "private": true,
  "main": "src/main/main.js",
  "author": {
    "name": "Sklubot",
    "email": "relais@sklubot.invalid"
  },
  "homepage": "https://github.com/smokersklubs-dot/grok-sklubs",
  "repository": {
    "type": "git",
    "url": "https://github.com/smokersklubs-dot/grok-sklubs.git",
    "directory": "companion"
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "electron .",
    "dev": "SKLUBOT_RELAIS_DEBUG=1 electron .",
    "test": "node --test \"test/unit/*.test.js\"",
    "test:e2e": "bash test/run-e2e.sh",
    "test:packaged": "bash test/run-e2e.sh packaged",
    "typecheck": "tsc -p jsconfig.json",
    "dist:linux": "electron-builder --linux --publish never",
    "dist:linux:dir": "electron-builder --linux dir --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win:zip": "electron-builder --win zip --publish never"
  },
  "dependencies": {
    "@jitsi/robotjs": "0.6.24",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "electron": "45.2.0",
    "electron-builder": "26.18.1",
    "typescript": "6.0.3"
  },
  "desktopName": "sklubot-relais.desktop",
  "build": {
    "appId": "fr.sklubot.relais",
    "productName": "Sklubot Relais",
    "artifactName": "Sklubot-Relais-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "!**/*.map"
    ],
    "asarUnpack": [
      "node_modules/@jitsi/robotjs/**"
    ],
    "npmRebuild": false,
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "icon": "build/icon.png",
      "synopsis": "Laisse tes bots Sklubot piloter ton ordinateur, avec ton accord",
      "desktop": {
        "entry": {
          "Name": "Sklubot Relais",
          "StartupWMClass": "Sklubot Relais"
        }
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "runAfterFinish": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true
    },
    "dmg": {
      "title": "Sklubot Relais"
    },
    "publish": []
  }
}
