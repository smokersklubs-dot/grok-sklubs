{
  "name": "sklubot-desktop",
  "productName": "Sklubot",
  "version": "1.0.0",
  "description": "Sklubot : ton équipe de bots dans une fenêtre, avec le Relais intégré pour qu'ils pilotent ton ordinateur, avec ton accord.",
  "license": "MIT",
  "private": true,
  "main": "src/main/main.js",
  "author": {
    "name": "Sklubot",
    "email": "desktop@sklubot.invalid"
  },
  "homepage": "https://github.com/smokersklubs-dot/grok-sklubs",
  "repository": {
    "type": "git",
    "url": "https://github.com/smokersklubs-dot/grok-sklubs.git",
    "directory": "companion"
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "electron .",
    "dev": "SKLUBOT_RELAIS_DEBUG=1 electron .",
    "test": "node --test \"test/unit/*.test.js\"",
    "test:e2e": "bash test/run-e2e.sh",
    "test:e2e:server": "RELAIS_E2E_FILES=test/e2e/sklubot-server.e2e.test.js bash test/run-e2e.sh",
    "test:packaged": "bash test/run-e2e.sh packaged",
    "typecheck": "tsc -p jsconfig.json",
    "dist:linux": "electron-builder --linux AppImage deb --publish never",
    "dist:linux:dir": "electron-builder --linux dir --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win:zip": "electron-builder --win zip --publish never",
    "icons": "electron scripts/make-icons.js"
  },
  "dependencies": {
    "@jitsi/robotjs": "0.6.24",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "electron": "45.2.0",
    "electron-builder": "26.18.1",
    "typescript": "6.0.3"
  },
  "desktopName": "sklubot.desktop",
  "build": {
    "appId": "fr.sklubot.desktop",
    "productName": "Sklubot",
    "artifactName": "Sklubot-${version}-${os}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "!**/*.map"
    ],
    "asarUnpack": [
      "node_modules/@jitsi/robotjs/**"
    ],
    "npmRebuild": false,
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Network",
      "icon": "build/icons",
      "synopsis": "Ton équipe de bots Sklubot dans une fenêtre, Relais intégré",
      "description": "L'application Sklubot pour ordinateur : ton serveur Sklubot dans une fenêtre, avec notifications, icône dans la barre et le Relais intégré.",
      "desktop": {
        "entry": {
          "Name": "Sklubot",
          "StartupWMClass": "Sklubot"
        }
      },
      "executableName": "sklubot"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "runAfterFinish": true,
      "shortcutName": "Sklubot",
      "uninstallDisplayName": "Sklubot"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Sklubot utilise le micro pour parler à tes bots (mode vocal)."
      }
    },
    "dmg": {
      "title": "Sklubot"
    },
    "publish": []
  }
}
